rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funcions auxiliars d'autenticació i rols
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRoleData() {
      return get(/databases/$(database)/documents/rols/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/rols/$(request.auth.uid)) &&
        getUserRoleData().rol == 'admin';
    }
    
    // B4: Comprovació que l'operari està donat d'alta i actiu a operaris/{id}
    function isOperari() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/rols/$(request.auth.uid)) &&
        getUserRoleData().rol == 'operari' &&
        exists(/databases/$(database)/documents/operaris/$(string(getUserRoleData().operariId))) &&
        get(/databases/$(database)/documents/operaris/$(string(getUserRoleData().operariId))).data.actiu == true;
    }
    
    function getOperariId() {
      return getUserRoleData().operariId;
    }

    // Col·lecció de rols:
    // - Un usuari pot llegir el seu propi document de rol (o admin qualsevol).
    // - Només admin pot crear, modificar o esborrar rols.
    match /rols/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Col·lecció d'operaris (personal municipal de la brigada):
    // - Lectura permesa per a qualsevol usuari autenticat (necessari per a selectors i llistat de contacte).
    // - Escriptura reservada estrictament a l'administrador (Cap de Brigada).
    match /operaris/{operariId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      // B5: Subcol·lecció d'absències i dades de salut (RGPD Art. 9)
      // L'operari només pot llegir el seu propi historial; cap altre operari pot accedir-hi.
      match /absencies/{absenciaId} {
        allow read: if isAdmin() || (isOperari() && string(getOperariId()) == operariId);
        allow write: if isAdmin();
      }
    }

    // Col·lecció de tasques (ordres de treball municipals):
    // - B1: Lectura permesa a admin o a l'operari assignat (sense condició estàtica 'is list' que bloqueja consultes)
    // - Creació i eliminació: exclusivament admin.
    // - B2: Actualització per operari: denegada si estat == 'finalitzada', camps restringits i validació de signatura
    match /tasques/{tascaId} {
      allow read: if isAdmin() || (
        isOperari() && 
        getOperariId() in resource.data.operariIds
      );
      
      allow create, delete: if isAdmin();
      
      allow update: if isAdmin() || (
        isOperari() &&
        getOperariId() in resource.data.operariIds &&
        resource.data.estat != 'finalitzada' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estat', 
          'tempsTotalSegons', 
          'tempsInici', 
          'tempsPausa', 
          'tempsFinalitzacio',
          'finalitzadaEl',
          'nomSignatari', 
          'observacionsTancament',
          'teFotoFinal',
          'teSignatura'
        ]) &&
        (!('estat' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.estat in ['en_curs', 'pendent_material', 'finalitzada']) &&
        (request.resource.data.estat != 'finalitzada' || (
          request.resource.data.teSignatura == true &&
          request.resource.data.nomSignatari is string &&
          request.resource.data.nomSignatari.size() > 0 &&
          request.resource.data.nomSignatari.size() <= 120
        )) &&
        (!('tempsTotalSegons' in request.resource.data.diff(resource.data).affectedKeys()) || (
          request.resource.data.tempsTotalSegons is number &&
          request.resource.data.tempsTotalSegons >= 0 &&
          request.resource.data.tempsTotalSegons < 2592000
        ))
      );

      // B3: Subcol·lecció d'adjunts pesats (fotografies i signatures en Base64)
      match /adjunts/{adjuntId} {
        // Lectura permesa a admin i als operaris assignats a la tasca pare
        allow read: if isAdmin() || (
          isOperari() &&
          getOperariId() in get(/databases/$(database)/documents/tasques/$(tascaId)).data.operariIds
        );

        // Validació d'identificadors permesos: fotoInicial, fotoFinal, signatura.
        // Operari només pot CREAR fotoFinal i signatura si la tasca no està finalitzada. Mai fotoInicial.
        allow create: if adjuntId in ['fotoInicial', 'fotoFinal', 'signatura'] && (
          isAdmin() || (
            isOperari() &&
            adjuntId in ['fotoFinal', 'signatura'] &&
            getOperariId() in get(/databases/$(database)/documents/tasques/$(tascaId)).data.operariIds &&
            get(/databases/$(database)/documents/tasques/$(tascaId)).data.estat != 'finalitzada' &&
            request.resource.data.data.matches('^data:image/(png|jpeg|webp);base64,.*')
          )
        ) && (
          request.resource.data.data is string && request.resource.data.data.size() < 972800
        );

        // L'operari no pot sobreescriure ni esborrar adjunts existents
        allow update, delete: if isAdmin();
      }
    }

    // Tasques programades (manteniment preventiu):
    // - Accés exclusiu de l'administrador.
    match /tasques_programades/{progId} {
      allow read, write: if isAdmin();
    }

    // E3: Comptadors atòmics per a identificadors transaccionals
    match /comptadors/{comptadorId} {
      allow read, write: if isAdmin();
    }
  }
}
