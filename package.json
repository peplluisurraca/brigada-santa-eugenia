{
  "name": "brigada-santa-eugenia",
  "version": "1.0.0",
  "description": "Repositori centralitzat de l'aplicació Brigada Municipal de Santa Eugènia",
  "type": "module",
  "scripts": {
    "start": "node brigada-mantenimiento/server.js",
    "test": "node --test tests/xss.test.mjs tests/offline.test.mjs tests/adjunts.test.mjs tests/usabilitat.test.mjs",
    "test:rules": "node --test tests/rules.test.mjs",
    "build:css": "tailwindcss -i brigada-mantenimiento/css/input.css -o brigada-mantenimiento/css/dist.css --minify",
    "auth:bootstrap": "node scripts/bootstrap-auth.mjs",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-admin": "^12.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^3.4.19"
  },
  "keywords": [
    "pwa",
    "santa-eugenia",
    "brigada"
  ],
  "author": "Ajuntament de Santa Eugènia",
  "license": "UNLICENSED"
}
